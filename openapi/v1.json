        ],
        "summary": "Cập nhật thông số cơ sở mình",
        "description": "Cập nhật thông số cơ sở mình; trường chỉ Chủ sở hữu được sửa gửi lên bị 400. Không nhận mã cơ sở; chỉ vai trò BranchManager được gọi.",
        "operationId": "updateManagerBranchSettings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BranchSettingsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
