{
  "openapi": "3.1.1",
  "info": {
    "title": "Bepthaymao Ordering API",
    "description": "API công khai nhận đơn đa cơ sở. Phiên bản nằm trong đường dẫn (/api/v1).",
    "contact": {
      "name": "Đội phát triển Bếp Thầy Mão",
      "url": "https://github.com/thanglm240723/BepThayMao-Spec"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/branches": {
      "get": {
        "tags": [
          "Branches"
        ],
        "summary": "Danh sách cơ sở đang hoạt động",
        "description": "Chỉ trả thông tin công khai tối thiểu; không lộ tọa độ, cấu hình ngân hàng, SePay, Zalo hay cờ hoạt động.",
        "operationId": "listPublicBranches",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PublicBranch"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProblemDetails": {
        "required": [
          "correlationId",
          "title",
          "status"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "correlationId": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "PublicBranch": {
        "required": [
          "id",
          "name",
          "address",
          "phone",
          "openTime",
          "closeTime"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "openTime": {
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "type": "string"
          },
          "closeTime": {
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Branches"
    }
  ]
}