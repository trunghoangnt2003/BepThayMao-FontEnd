  "components": {
    "schemas": {
      "BranchOwnerSettingsRequest": {
        "required": [
          "name",
          "address",
          "phone",
          "lat",
          "lng",
          "openTime",
          "closeTime",
          "abandonedThresholdMinutes",
          "zaloRecipientIds",
          "isActive"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "format": "double"
          },
          "lng": {
            "type": "number",
            "format": "double"
          },
          "openTime": {
            "type": "string"
          },
          "closeTime": {
            "type": "string"
          },
          "abandonedThresholdMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "zaloRecipientIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isActive": {
            "type": "boolean"
          },
          "bankAccountNo": {
            "type": [
              "null",
              "string"
            ]
          },
          "bankCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "sepayAccountRef": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "BranchResponse": {
        "required": [
          "id",
          "name",
          "address",
          "lat",
          "lng",
          "phone",
          "isActive",
          "openTime",
          "closeTime",
          "abandonedThresholdMinutes",
          "zaloRecipientIds",
          "bankAccountNo",
          "bankCode",
          "sepayAccountRef",
          "managerIdentifier"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "format": "double"
          },
          "lng": {
            "type": "number",
            "format": "double"
          },
          "phone": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "openTime": {
            "type": "string"
          },
          "closeTime": {
            "type": "string"
          },
          "abandonedThresholdMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "zaloRecipientIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bankAccountNo": {
            "type": [
              "null",
              "string"
            ]
          },
          "bankCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "sepayAccountRef": {
            "type": [
              "null",
              "string"
            ]
          },
          "managerIdentifier": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "BranchSettingsRequest": {
        "required": [
          "phone",
          "openTime",
          "closeTime",
          "abandonedThresholdMinutes",
          "zaloRecipientIds"
        ],
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "openTime": {
            "type": "string"
          },
          "closeTime": {
            "type": "string"
          },
          "abandonedThresholdMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "zaloRecipientIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "description": "Đúng năm trường Quản lý được sửa; thành viên khác (name, isActive, lat, ngân hàng...) bị từ chối bằng 400."
      },
      "CreateBranchRequest": {
        "required": [
          "branch",
          "manager"
        ],
        "type": "object",
        "properties": {
          "branch": {
            "$ref": "#/components/schemas/BranchOwnerSettingsRequest"
          },
          "manager": {
            "$ref": "#/components/schemas/ManagerAccountRequest"
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "required": [
          "identifier",
          "password"
        ],
        "type": "object",
        "properties": {
          "identifier": {
            "maxLength": 256,
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 10,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ManagerAccountRequest": {
        "required": [
          "identifier",
          "password"
        ],
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ManagerBranchView": {
        "required": [
          "phone",
          "openTime",
          "closeTime",
          "abandonedThresholdMinutes",
          "zaloRecipientIds",
          "name",
          "address",
          "isActive",
          "bankAccountNo",
          "bankCode",
          "sepayAccountRef"
        ],
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "openTime": {
            "type": "string"
          },
          "closeTime": {
            "type": "string"
          },
          "abandonedThresholdMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "zaloRecipientIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "bankAccountNo": {
            "type": [
              "null",
              "string"
            ]
          },
          "bankCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "sepayAccountRef": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProblemDetails": {
        "required": [
          "correlationId"
        ],
        "type": "object",
        "properties": {
