{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "customer": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/customer",
      "sourceRoot": "projects/customer/src",
      "prefix": "cus",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/customer/src/main.ts",
            "tsConfig": "projects/customer/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/customer/public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/vollkorn/latin-600.css",
              "node_modules/@fontsource/vollkorn/latin-ext-600.css",
              "node_modules/@fontsource/vollkorn/vietnamese-600.css",
              "node_modules/@fontsource/hanken-grotesk/latin-400.css",
              "node_modules/@fontsource/hanken-grotesk/latin-ext-400.css",
              "node_modules/@fontsource/hanken-grotesk/vietnamese-400.css",
              "node_modules/@fontsource/hanken-grotesk/latin-600.css",
              "node_modules/@fontsource/hanken-grotesk/latin-ext-600.css",
              "node_modules/@fontsource/hanken-grotesk/vietnamese-600.css",
              "projects/ui/src/styles/index.css"
            ],
            "server": "projects/customer/src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": ["localhost", "127.0.0.1"]
            },
            "ssr": {
              "entry": "projects/customer/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "customer:build:production"
            },
            "development": {
              "buildTarget": "customer:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverage": true,
            "coverageThresholds": {
              "statements": 80,
              "branches": 75,
              "functions": 80,
              "lines": 80
            },
            "coverageExclude": ["**/*.spec.ts", "**/main.ts", "**/main.server.ts", "**/server.ts"]
          }
        }
      }
    },
    "admin": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/admin",
      "sourceRoot": "projects/admin/src",
      "prefix": "adm",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/admin/src/main.ts",
            "tsConfig": "projects/admin/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/admin/public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/vollkorn/latin-600.css",
              "node_modules/@fontsource/vollkorn/latin-ext-600.css",
              "node_modules/@fontsource/vollkorn/vietnamese-600.css",
              "node_modules/@fontsource/hanken-grotesk/latin-400.css",
              "node_modules/@fontsource/hanken-grotesk/latin-ext-400.css",
              "node_modules/@fontsource/hanken-grotesk/vietnamese-400.css",
              "node_modules/@fontsource/hanken-grotesk/latin-600.css",
              "node_modules/@fontsource/hanken-grotesk/latin-ext-600.css",
              "node_modules/@fontsource/hanken-grotesk/vietnamese-600.css",
              "projects/ui/src/styles/index.css"
            ],
            "baseHref": "/admin/"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "admin:build:production"
            },
            "development": {
              "buildTarget": "admin:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "servePath": "/admin/",
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverage": true,
            "coverageThresholds": {
              "statements": 80,
              "branches": 75,
              "functions": 80,
              "lines": 80
            },
            "coverageExclude": ["**/*.spec.ts", "**/main.ts", "**/main.server.ts", "**/server.ts"]
          }
        }
      }
    },
    "api-client": {
      "projectType": "library",
      "root": "projects/api-client",
      "sourceRoot": "projects/api-client/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/api-client/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/api-client/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/api-client/tsconfig.spec.json"
          }
        }
      }
    },
    "core": {
      "projectType": "library",
      "root": "projects/core",
      "sourceRoot": "projects/core/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/core/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/core/tsconfig.spec.json",
            "coverage": true,
            "coverageThresholds": {
              "statements": 80,
              "branches": 75,
              "functions": 80,
              "lines": 80
            },
            "coverageExclude": ["**/*.spec.ts", "**/main.ts", "**/main.server.ts", "**/server.ts"]
          }
        }
      }
    },
    "ui": {
      "projectType": "library",
      "root": "projects/ui",
      "sourceRoot": "projects/ui/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ui/tsconfig.spec.json",
            "coverage": true,
            "coverageThresholds": {
              "statements": 80,
              "branches": 75,
              "functions": 80,
              "lines": 80
            },
            "coverageExclude": ["**/*.spec.ts", "**/main.ts", "**/main.server.ts", "**/server.ts"]
          }
        }
      }
    }
  }
}
