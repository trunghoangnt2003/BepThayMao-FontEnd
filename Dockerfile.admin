# Admin SPA served by unprivileged nginx under /admin/. Build context: frontend/ only.
FROM node:24.22.2-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build:admin

FROM nginxinc/nginx-unprivileged:1.31.7-alpine AS runtime
COPY nginx/admin.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/admin/browser /usr/share/nginx/html/admin/
EXPOSE 8080
